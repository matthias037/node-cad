<?xml version="1.0" encoding="utf-8"?>
<!--
  NØDE CAD MSI (WiX Toolset v5, plus the UI and Util extensions). Built by package.ps1:

    wix build solidcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc solidcraft.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install with a setup wizard: Welcome, install folder (Program Files\NODE CAD by
  default, remembered for upgrades), Ready, progress, and a Finish page with a ticked "Launch
  NØDE CAD" box. Installs a Start Menu shortcut, node-cad-cli (and its former names
  solidcraft-cli and solvecraft-cli), the licence files (including THIRD-PARTY-LICENSES.txt),
  makes NØDE CAD the owner of `.nodecad` (and of the earlier `.solidcraft` and `.solvecraft`),
  and offers it under "Open with" for STEP, IGES, 3MF and STL. `msiexec /qn` installs silently.
  Adapted from PhotoCraft's (storytold/photocraft, Apache-2.0; see ATTRIBUTION.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Never change the UpgradeCode: it is what lets a new MSI replace every earlier install
       (docs/compatibility.md). -->
  <!-- Codepage 1252 holds the Ø of the product name. -->
  <Package
      Name="NØDE CAD"
      Codepage="1252"
      Manufacturer="NØDE"
      Version="$(var.Version)"
      UpgradeCode="6A145FD6-D285-428D-AE84-A69570CDF4DB"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="NØDE CAD parametric 3D CAD" Manufacturer="NØDE" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of NØDE CAD is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Advertised shortcuts to an .exe need an .exe icon identifier (ICE50). -->
    <Icon Id="NodeCadIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="NodeCadIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://node-os.fr/cad" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/matthias037/node-cad/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/matthias037/node-cad/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NODE CAD" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by NodeCadApp).
         An install from before the rename recorded another key, which isn't read: its upgrade
         (same UpgradeCode) removes the old folder and installs into Program Files\NODE CAD
         (docs/compatibility.md). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\NODE CAD" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="NØDE CAD" Level="1">
      <ComponentGroupRef Id="NodeCadFiles" />
    </Feature>

    <!-- WixUI_InstallDir without its licence page (Apache-2.0: nothing to accept). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchNodeCad"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <Property Id="NodeCadVersion" Value="$(var.DisplayVersion)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="NØDE CAD $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch NØDE CAD" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#NodeCadExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user. -->
    <CustomAction Id="LaunchNodeCad" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="NodeCadFiles" Directory="INSTALLFOLDER">
      <!-- A new GUID with the rename: the key file changed to node-cad.exe. The UpgradeCode above
           is unchanged, so this MSI major-upgrades an install from before the rename. -->
      <Component Id="NodeCadApp" Guid="9F60EA34-9480-400D-98AC-46CBD2C9061C">
        <File Id="NodeCadExe" Source="$(var.BinDir)\node-cad.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="NØDE CAD"
              Description="NØDE CAD parametric 3D CAD" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="NodeCadIcon.exe" IconIndex="0" />
        </File>

        <!-- .nodecad: NØDE CAD's own format; NØDE CAD is its default app. -->
        <ProgId Id="NodeCad.Design" Description="NØDE CAD Design" Icon="NodeCadExe" IconIndex="0">
          <Extension Id="nodecad" ContentType="application/x-nodecad">
            <Verb Id="open" Command="Open" TargetFile="NodeCadExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Compatibility shim (docs/compatibility.md): designs saved with the earlier extensions
             open as the same ProgId. Registered by hand: a second Extension under one ProgId would
             write its open verb twice (WIX0091). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.solidcraft" Value="NodeCad.Design" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solidcraft" Name="Content Type" Value="application/x-solidcraft" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft" Value="NodeCad.Design" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.solvecraft" Name="Content Type" Value="application/x-solvecraft" Type="string" />
        <!-- STEP, IGES and meshes: offered under "Open with", never forced as the default. -->
        <ProgId Id="NodeCad.Model" Description="3D model" Icon="NodeCadExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\NodeCad.Model\shell\open\command" Value="&quot;[#NodeCadExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.step\OpenWithProgids" Name="NodeCad.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stp\OpenWithProgids" Name="NodeCad.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.igs\OpenWithProgids" Name="NodeCad.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.iges\OpenWithProgids" Name="NodeCad.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.3mf\OpenWithProgids" Name="NodeCad.Model" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.stl\OpenWithProgids" Name="NodeCad.Model" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "node-cad"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\node-cad.exe" Name="FriendlyAppName" Value="NØDE CAD" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\node-cad.exe\shell\open\command" Value="&quot;[#NodeCadExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\node-cad.exe\SupportedTypes" Name=".nodecad" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\node-cad.exe\SupportedTypes" Name=".solidcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\node-cad.exe\SupportedTypes" Name=".solvecraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\node-cad.exe\SupportedTypes" Name=".step" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\node-cad.exe\SupportedTypes" Name=".stp" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\node-cad.exe\SupportedTypes" Name=".igs" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\node-cad.exe\SupportedTypes" Name=".iges" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\node-cad.exe\SupportedTypes" Name=".3mf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\node-cad.exe\SupportedTypes" Name=".stl" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\node-cad.exe" Value="[#NodeCadExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\NODE CAD" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="NodeCadCli">
        <File Id="NodeCadCliExe" Source="$(var.BinDir)\node-cad-cli.exe" KeyPath="yes" />
      </Component>
      <!-- Compatibility shim (docs/compatibility.md): the CLI's former names, forwarding to node-cad-cli. -->
      <Component Id="SolidcraftCliAlias">
        <File Id="SolidcraftCliAliasExe" Source="$(var.BinDir)\solidcraft-cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="SolvecraftCliAlias">
        <File Id="SolvecraftCliAliasExe" Source="$(var.BinDir)\solvecraft-cli.exe" KeyPath="yes" />
      </Component>
      <!-- Several unversioned files: an explicit GUID (WIX0367). -->
      <Component Id="NodeCadLicences" Guid="CDEDEE8D-4BE9-4872-A2EA-EE623A6C7E91">
        <File Id="LicenseMit" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
        <File Id="LicenseApache" Source="$(var.BinDir)\LICENSE-APACHE" />
        <File Id="Notice" Source="$(var.BinDir)\NOTICE" />
        <File Id="ThirdParty" Source="$(var.BinDir)\THIRD-PARTY-LICENSES.txt" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
